{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Req2Run Problem Schema (minimal)",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "difficulty": { "type": "string", "enum": ["basic","intermediate","advanced","expert"] },
    "category": { "type": "string" },
    "requirements": { "type": "object" }
  },
  "required": ["id","title","difficulty","category","requirements"],
  "additionalProperties": true
}
